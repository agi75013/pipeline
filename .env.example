# Copier vers .env.local (jamais versionné). Aucun secret ici.
# Base SQLite locale (valeur par défaut si absente).
# Pour Turso : DATABASE_URL=libsql://<base>.turso.io et le jeton dans DATABASE_AUTH_TOKEN,
# renseignés uniquement dans .env.local et dans les variables Vercel.
DATABASE_URL=file:pipeline.db
DATABASE_AUTH_TOKEN=
